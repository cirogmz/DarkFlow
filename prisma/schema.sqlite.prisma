datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  passwordHash  String
  name          String
  role          String          @default("CASHIER")
  brands        UserBrand[]
  orders        Order[]         @relation("DeliveryDriver")
  cashSessions  CashSession[]
  deliveryProfile DeliveryProfile?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Brand {
  id             String        @id @default(uuid())
  name           String        @unique
  slug           String        @unique
  logoUrl        String?
  primaryColor   String        @default("#E2E8F0")
  secondaryColor String        @default("#0F172A")
  isActive       Boolean       @default(true)
  users          UserBrand[]
  categories     Category[]
  products       Product[]
  ingredients    Ingredient[]
  orders         Order[]
  purchases      Purchase[]
  cashSessions   CashSession[]
  tables         Table[]
  customers      Customer[]
  coupons        Coupon[]
  combos         Combo[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model UserBrand {
  userId  String
  brandId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([userId, brandId])
}

model Table {
  id        String    @id @default(uuid())
  number    String
  name      String
  capacity  Int       @default(4)
  status    String    @default("AVAILABLE")
  zone      String    @default("Salón")
  brandId   String
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  orders    Order[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([number, brandId])
}

model Category {
  id        String    @id @default(uuid())
  name      String
  brandId   String
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([name, brandId])
}

model Product {
  id          String       @id @default(uuid())
  name        String
  description String?
  price       Float
  imageUrl    String?
  categoryId  String
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  brandId     String
  brand       Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  isActive    Boolean      @default(true)
  recipeItems RecipeItem[]
  orderItems  OrderItem[]
  comboItems  ComboItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Ingredient {
  id          String       @id @default(uuid())
  name        String
  stock       Float        @default(0)
  unit        String
  cost        Float        @default(0)
  minStock    Float        @default(0)
  brandId     String
  brand       Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  recipeItems RecipeItem[]
  purchases   Purchase[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([name, brandId])
}

model RecipeItem {
  id           String     @id @default(uuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity     Float
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([productId, ingredientId])
}

model Order {
  id           String       @id @default(uuid())
  orderNumber  String       @unique
  brandId      String
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  source       String       @default("WEB")
  status       String       @default("RECEIVED")
  customerName String
  customerPhone String?
  customerAddress String?
  notes        String?
  subtotal     Float
  tax          Float
  tip          Float        @default(0)
  total        Float
  driverId     String?
  driver       User?        @relation("DeliveryDriver", fields: [driverId], references: [id])
  tableId      String?
  table        Table?       @relation(fields: [tableId], references: [id])
  diners       Int?         @default(1)
  customerId   String?
  customer     Customer?    @relation(fields: [customerId], references: [id])
  couponId     String?
  coupon       Coupon?      @relation(fields: [couponId], references: [id])
  couponCode   String?
  discountAmount Float      @default(0)
  externalOrderId String?
  platformCommissionRate Float? @default(0)
  platformCommission Float? @default(0)
  netPayout    Float?
  deliveryService String?
  items        OrderItem[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  notes     String?
}

model Purchase {
  id           String     @id @default(uuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity     Float
  cost         Float
  supplier     String?
  purchaseDate DateTime   @default(now())
  brandId      String
  brand        Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

model CashSession {
  id             String            @id @default(uuid())
  brandId        String
  brand          Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  openingBalance Float
  closingBalance Float?
  expectedBalance Float?
  actualBalance  Float?
  status         String            @default("OPEN")
  cashSales      Float             @default(0)
  cardSales      Float             @default(0)
  appsSales      Float             @default(0)
  notes          String?
}

model DeliveryProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType String
  plateNumber String?
  status      String   @default("AVAILABLE")
}

model Customer {
  id            String    @id @default(uuid())
  name          String
  phone         String    @unique
  email         String?
  address       String?
  notes         String?
  totalOrders   Int       @default(0)
  totalSpent    Float     @default(0.0)
  loyaltyPoints Int       @default(0)
  brandId       String?
  brand         Brand?    @relation(fields: [brandId], references: [id])
  orders        Order[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  description    String?
  discountType   String
  discountValue  Float
  minOrderAmount Float     @default(0)
  maxDiscount    Float?
  usageLimit     Int?
  usedCount      Int       @default(0)
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean   @default(true)
  brandId        String?
  brand          Brand?    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  orders         Order[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Combo {
  id          String      @id @default(uuid())
  name        String
  description String?
  price       Float
  imageUrl    String?
  isActive    Boolean     @default(true)
  brandId     String
  brand       Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  items       ComboItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model ComboItem {
  id        String   @id @default(uuid())
  comboId   String
  combo     Combo    @relation(fields: [comboId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
}
