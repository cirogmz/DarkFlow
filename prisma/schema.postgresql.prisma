datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  passwordHash  String
  name          String
  role          String          @default("CASHIER")
  brands        UserBrand[]
  orders        Order[]         @relation("DeliveryDriver")
  cashSessions  CashSession[]
  deliveryProfile DeliveryProfile?
  auditLogs     AuditLog[]
  productionBatches ProductionBatch[]
  warehouseTransfers WarehouseTransfer[]
  wasteLogs     WasteLog[]
  pinCode       String?
  hourlyWage    Float?          @default(65)
  attendanceRecords AttendanceRecord[]
  inventoryAudits InventoryAudit[]
  requestedRequisitions InternalRequisition[] @relation("RequisitionRequester")
  approvedRequisitions  InternalRequisition[] @relation("RequisitionApprover")
  dispatchedRequisitions InternalRequisition[] @relation("RequisitionDispatcher")
  receivedRequisitions  InternalRequisition[] @relation("RequisitionReceiver")
  securityIncidents     SecurityIncident[]
  driverSettlements     DriverSettlement[] @relation("SettledDriver")
  cashierSettlements    DriverSettlement[] @relation("SettlementCashier")
  waiterOrders          Order[]            @relation("WaiterOrders")
  assignedTables        Table[]            @relation("AssignedWaiterTables")
  createdPurchaseOrders PurchaseOrder[]    @relation("PurchaseOrderCreator")
  receivedPurchaseOrders PurchaseOrder[]   @relation("PurchaseOrderReceiver")
  createdPrepLists      DailyPrepList[]
  franchiseContracts    FranchiseContract[] @relation("FranchiseUser")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Brand {
  id             String        @id @default(uuid())
  name           String        @unique
  slug           String        @unique
  logoUrl        String?
  primaryColor   String        @default("#E2E8F0")
  secondaryColor String        @default("#0F172A")
  isActive       Boolean       @default(true)
  users          UserBrand[]
  categories     Category[]
  products       Product[]
  ingredients    Ingredient[]
  orders         Order[]
  purchases      Purchase[]
  cashSessions   CashSession[]
  tables         Table[]
  customers      Customer[]
  coupons        Coupon[]
  combos         Combo[]
  auditLogs      AuditLog[]
  paymentSandboxMode Boolean     @default(true)
  allowOnlinePayments Boolean    @default(true)
  stripeSecretKey    String?
  stripePublicKey    String?
  stripeWebhookSecret String?
  mpAccessToken      String?
  mpPublicKey        String?
  mpWebhookSecret    String?
  paymentTransactions PaymentTransaction[]
  modifierGroups ModifierGroup[]
  warehouses     Warehouse[]
  productionBatches ProductionBatch[]
  warehouseTransfers WarehouseTransfer[]
  wasteLogs      WasteLog[]
  rfc            String?
  legalName      String?
  taxRegime      String?       @default("601")
  postalCode     String?
  invoiceSeries  String?       @default("FAC")
  invoiceNextFolio Int         @default(1)
  pacEnvironment String        @default("SANDBOX")
  invoices       Invoice[]
  printers       Printer[]
  attendanceRecords AttendanceRecord[]
  reservations   Reservation[]
  waitlistEntries WaitlistEntry[]
  priceRules     PriceRule[]
  giftCards      GiftCard[]
  inventoryAudits InventoryAudit[]
  internalRequisitions InternalRequisition[]
  surveys        SatisfactionSurvey[]
  securityIncidents SecurityIncident[]
  driverSettlements DriverSettlement[]
  suppliers      Supplier[]
  purchaseOrders PurchaseOrder[]
  batches        IngredientBatch[]
  prepLists      DailyPrepList[]
  temperatureSensors TemperatureSensor[]
  temperatureAlerts  TemperatureAlert[]
  deliverySettlements DeliveryPayoutSettlement[]
  deliveryDisputes    DeliveryDispute[]
  franchiseContracts  FranchiseContract[]
  royaltyStatements   RoyaltyStatement[]
  walletTransactions  CustomerWalletTransaction[]
  targetFoodCostPct  Float?        @default(30)
  targetLaborCostPct Float?        @default(20)
  targetPrimeCostPct Float?        @default(55)
  targetDailySales   Float?        @default(15000)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model UserBrand {
  userId  String
  brandId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([userId, brandId])
}

model Table {
  id        String    @id @default(uuid())
  number    String
  name      String
  capacity  Int       @default(4)
  status    String    @default("AVAILABLE")
  zone      String    @default("Salón")
  brandId   String
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  assignedWaiterId String?
  assignedWaiter   User?     @relation("AssignedWaiterTables", fields: [assignedWaiterId], references: [id])
  orders    Order[]
  reservations Reservation[]
  waitlistEntries WaitlistEntry[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([number, brandId])
}

model Category {
  id        String    @id @default(uuid())
  name      String
  brandId   String
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([name, brandId])
}

model Product {
  id          String       @id @default(uuid())
  name        String
  description String?
  price       Float
  imageUrl    String?
  categoryId  String
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  brandId     String
  brand       Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  isActive    Boolean      @default(true)
  targetPrepTime Int?      @default(10)
  kitchenStation String?   @default("COCINA")
  allergens   String?
  dietaryTags String?
  targetFoodCostPct Float? @default(30)
  recipeItems RecipeItem[]
  orderItems  OrderItem[]
  comboItems  ComboItem[]
  modifierGroups ProductModifierGroup[]
  prepItems   DailyPrepItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Ingredient {
  id          String       @id @default(uuid())
  name        String
  stock       Float        @default(0)
  unit        String
  cost        Float        @default(0)
  minStock    Float        @default(0)
  parLevel    Float?       @default(10)
  reorderPoint Float?      @default(5)
  type        String       @default("RAW")
  yieldQuantity Float?
  yieldUnit   String?
  allergens   String?
  brandId     String
  brand       Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  recipeItems RecipeItem[]
  purchases   Purchase[]
  modifierOptions ModifierOption[]
  parentSubRecipes SubRecipeItem[] @relation("ParentSubRecipe")
  childSubRecipes  SubRecipeItem[] @relation("ChildSubRecipe")
  productionBatches ProductionBatch[]
  warehouseStocks  WarehouseStock[]
  warehouseTransfers WarehouseTransfer[]
  wasteLogs        WasteLog[]
  auditItems       InventoryAuditItem[]
  requisitionItems RequisitionItem[]
  suppliers        IngredientSupplier[]
  purchaseOrderItems PurchaseOrderItem[]
  batches          IngredientBatch[]
  prepItems        DailyPrepItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([name, brandId])
}

model RecipeItem {
  id           String     @id @default(uuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity     Float
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([productId, ingredientId])
}

model Order {
  id           String       @id @default(uuid())
  orderNumber  String       @unique
  brandId      String
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  source       String       @default("WEB")
  status       String       @default("RECEIVED")
  customerName String
  customerPhone String?
  customerAddress String?
  notes        String?
  subtotal     Float
  tax          Float
  tip          Float        @default(0)
  total        Float
  driverId     String?
  driver       User?        @relation("DeliveryDriver", fields: [driverId], references: [id])
  waiterId     String?
  waiter       User?        @relation("WaiterOrders", fields: [waiterId], references: [id])
  tableId      String?
  table        Table?       @relation(fields: [tableId], references: [id])
  diners       Int?         @default(1)
  customerId   String?
  customer     Customer?    @relation(fields: [customerId], references: [id])
  couponId     String?
  coupon       Coupon?      @relation(fields: [couponId], references: [id])
  couponCode   String?
  discountAmount Float      @default(0)
  externalOrderId String?
  platformCommissionRate Float? @default(0)
  platformCommission Float? @default(0)
  netPayout    Float?
  deliveryService String?
  paymentStatus String       @default("PENDING")
  paymentMethod String?
  paidAmount    Float        @default(0)
  changeAmount  Float        @default(0)
  paidAt        DateTime?
  paymentTransactionId String?
  paymentTransactions PaymentTransaction[]
  invoiceId    String?      @unique
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id])
  globalInvoiceId String?
  globalInvoice Invoice?    @relation("GlobalInvoiceOrders", fields: [globalInvoiceId], references: [id])
  survey       SatisfactionSurvey?
  prebillPrintedAt DateTime?
  prebillPrintedCount Int     @default(0)
  securityIncidents SecurityIncident[]
  driverSettlementId String?
  driverSettlement   DriverSettlement? @relation(fields: [driverSettlementId], references: [id])
  driverSettled      Boolean           @default(false)
  deliveryFee        Float             @default(0)
  dispatchedAt       DateTime?
  deliveredAt        DateTime?
  prepTimeTarget Int?       @default(15)
  cookingStartedAt DateTime?
  cookingFinishedAt DateTime?
  currentStage String?      @default("STARTER")
  expoStatus       String?   @default("PENDING")
  expoNotifiedAt   DateTime?
  expoAssembledAt  DateTime?
  expoPackedAt     DateTime?
  expoNotes        String?
  deliverySecuritySeal String?
  expoQcPassed         Boolean   @default(false)
  expoQcCheckedAt      DateTime?
  expoQcCheckedById    String?
  expoQcCheckedByName  String?
  expoQcNotes          String?
  expoTemperature      Float?
  expoHaccpStatus      String?   @default("PENDING")
  expoHoldTimeMinutes  Float?    @default(0)
  expoRecookRequested  Boolean   @default(false)
  expoRecookReason     String?
  expoChecklistState   String?
  barStatus        String?   @default("PENDING")
  barNotifiedAt    DateTime?
  barCompletedAt   DateTime?
  isComped         Boolean   @default(false)
  compType         String?
  compReason       String?
  compApprovedById String?
  compApprovedByName String?
  compApprovedAt   DateTime?
  compFoodCost     Float?    @default(0)
  compBeneficiaryName String?
  payoutSettlementId   String?
  payoutSettlement     DeliveryPayoutSettlement? @relation(fields: [payoutSettlementId], references: [id], onDelete: SetNull)
  reconciliationStatus String   @default("UNRECONCILED") // UNRECONCILED, RECONCILED, DISPUTED, EXCLUDED
  taxWithheldIsr       Float?   @default(0)
  taxWithheldIva       Float?   @default(0)
  payoutAdjustments    Float?   @default(0)
  disputes             DeliveryDispute[]
  walletAmountPaid     Float    @default(0.0)
  cashbackEarned       Float    @default(0.0)
  walletTransactions   CustomerWalletTransaction[]
  items        OrderItem[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model OrderItem {
  id           String    @id @default(uuid())
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  quantity     Int
  price        Float
  notes        String?
  modifiers    String?
  status       String    @default("PENDING")
  serviceStage String?   @default("MAIN")
  allergenAlert String?
  expoChecked  Boolean   @default(false)
  targetTempMin Float?
  actualTemp    Float?
  tempStatus    String?   @default("PENDING")
  barChecked   Boolean   @default(false)
  isComped     Boolean   @default(false)
  compType     String?
  startedAt    DateTime?
  finishedAt   DateTime?
  servedAt     DateTime?
}

model Purchase {
  id           String     @id @default(uuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity     Float
  cost         Float
  supplier     String?
  purchaseDate DateTime   @default(now())
  brandId      String
  brand        Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

model CashSession {
  id              String            @id @default(uuid())
  brandId         String
  brand           Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  openedAt        DateTime          @default(now())
  closedAt        DateTime?
  openingBalance  Float
  closingBalance  Float?
  expectedBalance Float?
  actualBalance   Float?
  status          String            @default("OPEN")
  cashSales       Float             @default(0)
  cardSales       Float             @default(0)
  appsSales       Float             @default(0)
  giftCardSales   Float             @default(0)
  transfersSales  Float             @default(0)
  cashInTotal     Float             @default(0)
  cashOutTotal    Float             @default(0)
  canceledTotal   Float             @default(0)
  discountsTotal  Float             @default(0)
  tipsTotal       Float             @default(0)
  tipsCash        Float             @default(0)
  tipsCard        Float             @default(0)
  consecutiveZ    Int?
  blindCount      String?
  notes           String?
  totalNetSales   Float?            @default(0)
  totalFoodCost   Float?            @default(0)
  totalLaborCost  Float?            @default(0)
  primeCostPct    Float?            @default(0)
  netContributionMargin Float?     @default(0)
  movements       CashMovement[]
  cuts            CashCut[]
  driverSettlements DriverSettlement[]
}

model CashMovement {
  id            String      @id @default(uuid())
  cashSessionId String
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  type          String      // "IN" (Entrada/Cambio) o "OUT" (Retiro/Sangria)
  amount        Float
  reason        String
  category      String?     // "CHANGE_FLOAT", "SAFE_DROP", "EXPENSE", "SUPPLIER_PAYMENT", "OTHER"
  createdById   String?
  createdByName String?
  createdAt     DateTime    @default(now())
}

model CashCut {
  id                  String      @id @default(uuid())
  cashSessionId       String
  cashSession         CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  cutType             String      // "CORTE_X" o "CORTE_Z"
  cutNumber           String      // ej. "X-001" o "Z-0042"
  consecutive         Int
  openedAt            DateTime
  cutAt               DateTime    @default(now())
  openingBalance      Float
  cashSales           Float       @default(0)
  cardSales           Float       @default(0)
  appsSales           Float       @default(0)
  giftCardSales       Float       @default(0)
  transfersSales      Float       @default(0)
  totalSales          Float       @default(0)
  cashInTotal         Float       @default(0)
  cashOutTotal        Float       @default(0)
  expectedCash        Float
  expectedTotal       Float
  declaredCash        Float
  declaredCard        Float       @default(0)
  declaredOther       Float       @default(0)
  totalDeclared       Float
  cashDifference      Float       // declaredCash - expectedCash (positivo = sobrante, negativo = faltante)
  totalDifference     Float
  denominations       String?     // JSON con conteo de billetes y monedas
  ordersCount         Int         @default(0)
  discountsTotal      Float       @default(0)
  canceledOrdersCount Int         @default(0)
  canceledAmount      Float       @default(0)
  tipsTotal           Float       @default(0)
  tipsCash            Float       @default(0)
  tipsCard            Float       @default(0)
  printedAt           DateTime?
  notes               String?
  createdById         String?
  createdByName       String?
  createdAt           DateTime    @default(now())
}

model DeliveryProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType        String
  plateNumber        String?
  phoneNumber        String?
  activeCashFloat    Float    @default(0)
  commissionPerOrder Float    @default(0)
  status             String   @default("AVAILABLE")
}

model Customer {
  id               String     @id @default(uuid())
  name             String
  phone            String     @unique
  email            String?
  address          String?
  notes            String?
  birthDate        String?
  tier             String     @default("BRONZE")
  pointsMultiplier Float      @default(1.0)
  tierDiscountPct  Float      @default(0.0)
  totalOrders      Int        @default(0)
  totalSpent          Float      @default(0.0)
  loyaltyPoints       Int        @default(0)
  walletBalance       Float      @default(0.0)
  walletQrCode        String?    @unique
  cashbackRatePct     Float?     @default(5.0)
  totalCashbackEarned Float      @default(0.0)
  totalCashbackSpent  Float      @default(0.0)
  walletTransactions  CustomerWalletTransaction[]
  brandId             String?
  brand               Brand?     @relation(fields: [brandId], references: [id])
  orders           Order[]
  giftCards        GiftCard[]
  surveys          SatisfactionSurvey[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  description    String?
  discountType   String
  discountValue  Float
  minOrderAmount Float     @default(0)
  maxDiscount    Float?
  usageLimit     Int?
  usedCount      Int       @default(0)
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean   @default(true)
  brandId        String?
  brand          Brand?    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  orders         Order[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Combo {
  id          String      @id @default(uuid())
  name        String
  description String?
  price       Float
  imageUrl    String?
  isActive    Boolean     @default(true)
  brandId     String
  brand       Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  items       ComboItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model ComboItem {
  id        String   @id @default(uuid())
  comboId   String
  combo     Combo    @relation(fields: [comboId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String?
  details    String?
  severity   String   @default("INFO")
  ipAddress  String?
  brandId    String?
  brand      Brand?   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([brandId, createdAt])
  @@index([action])
  @@index([entityType])
}

model PaymentTransaction {
  id               String   @id @default(uuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  brandId          String?
  brand            Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  gateway          String
  status           String   @default("PENDING")
  amount           Float
  tip              Float    @default(0)
  currency         String   @default("MXN")
  method           String?
  splitIndex       Int?
  notes            String?
  gatewayPaymentId String?
  gatewayOrderId   String?
  paymentUrl       String?
  rawResponse      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([orderId])
  @@index([brandId])
  @@index([gatewayPaymentId])
  @@index([status])
}

model ModifierGroup {
  id          String                 @id @default(uuid())
  name        String
  minSelect   Int                    @default(0)
  maxSelect   Int                    @default(1)
  isRequired  Boolean                @default(false)
  brandId     String
  brand       Brand                  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  options     ModifierOption[]
  products    ProductModifierGroup[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([name, brandId])
}

model ModifierOption {
  id                 String         @id @default(uuid())
  modifierGroupId    String
  modifierGroup      ModifierGroup  @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  name               String
  price              Float          @default(0)
  ingredientId       String?
  ingredient         Ingredient?    @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  ingredientQuantity Float?         @default(0)
  isDefault          Boolean        @default(false)
  order              Int            @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model ProductModifierGroup {
  id              String        @id @default(uuid())
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroupId String
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  order           Int           @default(0)

  @@unique([productId, modifierGroupId])
}

model Warehouse {
  id            String              @id @default(uuid())
  name          String
  code          String?
  description   String?
  isDefault     Boolean             @default(false)
  brandId       String
  brand         Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  stocks        WarehouseStock[]
  transfersFrom WarehouseTransfer[] @relation("TransferSource")
  transfersTo   WarehouseTransfer[] @relation("TransferDestination")
  wasteLogs     WasteLog[]
  inventoryAudits InventoryAudit[]
  requisitionsFrom InternalRequisition[] @relation("RequisitionSourceWarehouse")
  requisitionsTo   InternalRequisition[] @relation("RequisitionDestWarehouse")
  batches       IngredientBatch[]
  sensors       TemperatureSensor[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([name, brandId])
}

model WarehouseStock {
  id           String     @id @default(uuid())
  warehouseId  String
  warehouse    Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  stock        Float      @default(0)
  minStock     Float      @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([warehouseId, ingredientId])
}

model SubRecipeItem {
  id                 String     @id @default(uuid())
  parentIngredientId String
  parentIngredient   Ingredient @relation("ParentSubRecipe", fields: [parentIngredientId], references: [id], onDelete: Cascade)
  childIngredientId  String
  childIngredient    Ingredient @relation("ChildSubRecipe", fields: [childIngredientId], references: [id], onDelete: Cascade)
  quantity           Float
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@unique([parentIngredientId, childIngredientId])
}

model ProductionBatch {
  id           String     @id @default(uuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity     Float
  totalCost    Float
  unitCost     Float
  notes        String?
  brandId      String
  brand        Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?      @relation(fields: [userId], references: [id])
  createdAt    DateTime   @default(now())
}

model WarehouseTransfer {
  id              String     @id @default(uuid())
  ingredientId    String
  ingredient      Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity        Float
  fromWarehouseId String
  fromWarehouse   Warehouse  @relation("TransferSource", fields: [fromWarehouseId], references: [id], onDelete: Cascade)
  toWarehouseId   String
  toWarehouse     Warehouse  @relation("TransferDestination", fields: [toWarehouseId], references: [id], onDelete: Cascade)
  notes           String?
  brandId         String
  brand           Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?      @relation(fields: [userId], references: [id])
