  resolutionNotes      String?
  resolvedAt           DateTime?
  createdAt            DateTime          @default(now())

  @@index([brandId, createdAt])
  @@index([status])
}

model DeliveryPayoutSettlement {
  id                    String            @id @default(uuid())
  brandId               String
  brand                 Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  platform              String            // UBER_EATS, RAPPI, DIDI_FOOD
  folio                 String            // e.g. SETTLE-UBER-2026W42-01
  periodStart           DateTime
  periodEnd             DateTime
  bankDepositDate       DateTime?
  bankReference         String?           // e.g. SPEI 9948210 BANORTE
  status                String            @default("DRAFT") // DRAFT, RECONCILED, DISCREPANCY, DISPUTED
  ordersCount           Int               @default(0)
  grossSales            Float             @default(0)
  platformCommission    Float             @default(0)
  commissionTax         Float             @default(0) // IVA de comisión (16%)
  withholdingIsr        Float             @default(0) // Retención ISR (1% - 2.5%)
  withholdingIva        Float             @default(0) // Retención IVA (8%)
  promotionsFunded      Float             @default(0) // Promos/descuentos absorbidos por tienda
  adjustmentsRefunds    Float             @default(0) // Descuentos por cancelaciones / reembolsos cliente
  netPayoutCalculated   Float             @default(0) // Venta Bruta - Com - Tax - Retenciones - Promos - Ajustes
  bankDepositAmount     Float             @default(0) // Importe real recibido en banco
  variance              Float             @default(0) // bankDepositAmount - netPayoutCalculated
  notes                 String?
  reconciledById        String?
  reconciledByName      String?
  reconciledAt          DateTime?
  orders                Order[]
  disputes              DeliveryDispute[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([brandId, platform, status])
  @@index([brandId, periodStart, periodEnd])
}

model DeliveryDispute {
  id                    String                    @id @default(uuid())
  brandId               String
  brand                 Brand                     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  settlementId          String?
  settlement            DeliveryPayoutSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  orderId               String?
  order                 Order?                    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  platform              String                    // UBER_EATS, RAPPI, DIDI_FOOD
  externalOrderId       String?
  disputeType           String                    // UNPAID_ORDER, WRONGFUL_REFUND, COMMISSION_OVERCHARGE, CANCELLED_WITHOUT_PAYOUT
  claimedAmount         Float
  recoveredAmount       Float                     @default(0)
  status                String                    @default("OPEN") // OPEN, SUBMITTED_TO_APP, RESOLVED_WON, RESOLVED_LOST
  ticketFolio           String?                   // Folio ticket de soporte con la plataforma
  reason                String
  resolutionNotes       String?
  resolvedAt            DateTime?
  createdById           String?
  createdByName         String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([brandId, platform, status])
}

model FranchiseContract {
  id                 String             @id @default(uuid())
  brandId            String
  brand              Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?              @relation("FranchiseUser", fields: [userId], references: [id], onDelete: SetNull)
  contractFolio      String             @unique // e.g. FRAN-BURGER-01, INV-PIZZA-2026
  partnerType        String             @default("FRANCHISEE") // FRANCHISEE, INVESTOR, JOINT_VENTURE
  partnerName        String
  partnerEmail       String?
  partnerPhone       String?
  partnerRfc         String?
  bankName           String?
  bankAccount        String?
  royaltyFeePct      Float              @default(5.0) // % sobre venta neta
  marketingFeePct    Float              @default(2.0) // % para fondo de marketing cooperativo
  techFeeMonthly     Float              @default(1500.0) // Cuota fija mensual de software / POS
  commissaryFeePct   Float              @default(0.0) // % por uso de cocina central / ghost kitchen
  calculationBasis   String             @default("NET_SALES") // NET_SALES o GROSS_SALES
  equitySharePct     Float              @default(0.0) // Para inversionistas (% de participación en utilidades)
  minimumMonthlyFee  Float              @default(0.0) // Cuota mínima mensual garantizada
  startDate          DateTime
  endDate            DateTime?
  status             String             @default("ACTIVE") // ACTIVE, PAUSED, TERMINATED
  notes              String?
  statements         RoyaltyStatement[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([brandId, status])
}

model RoyaltyStatement {
  id                  String            @id @default(uuid())
  brandId             String
  brand               Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contractId          String
  contract            FranchiseContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  statementFolio      String            @unique // e.g. ROY-2026-M10-001
  periodMonth         Int               // 1 - 12
  periodYear          Int               // e.g. 2026
  periodStart         DateTime
  periodEnd           DateTime
  ordersCount         Int               @default(0)
  grossSales          Float             @default(0)
  taxAmount           Float             @default(0)
  discountsAmount     Float             @default(0)
  netSales            Float             @default(0)
  royaltyFeeAmount    Float             @default(0) // netSales * (royaltyFeePct / 100)
  marketingFeeAmount  Float             @default(0) // netSales * (marketingFeePct / 100)
  techFeeAmount       Float             @default(0) // cuota mensual
  commissaryFeeAmount Float             @default(0) // netSales * (commissaryFeePct / 100)
  totalDue            Float             @default(0) // royalty + marketing + tech + commissary
  investorShareAmount Float             @default(0) // Para inversionistas (monto liquidable a favor del socio)
  status              String            @default("DRAFT") // DRAFT, ISSUED, PAID, DISPUTED, CANCELLED
  issuedAt            DateTime?
  paidAt              DateTime?
  paymentMethod       String?           // SPEI, CREDIT_CARD, OFFSET
  paymentReference    String?           // Folio de transferencia bancaria
  notes               String?
  createdById         String?
  createdByName       String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([brandId, periodYear, periodMonth])
  @@index([contractId, status])
}

model CustomerWalletTransaction {
  id            String    @id @default(uuid())
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  brandId       String?
  brand         Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  orderId       String?
  order         Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type          String    // EARNED_CASHBACK, REDEEMED_PAYMENT, MANUAL_RECHARGE, REFUND_ADJUSTMENT, PROMO_BONUS
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  reference     String?
  notes         String?
  createdById   String?
  createdByName String?
  createdAt     DateTime  @default(now())

  @@index([customerId, createdAt])
  @@index([brandId])
  @@index([orderId])
  @@index([type])
}


