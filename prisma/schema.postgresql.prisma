datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  passwordHash  String
  name          String
  role          String          @default("CASHIER")
  brands        UserBrand[]
  orders        Order[]         @relation("DeliveryDriver")
  cashSessions  CashSession[]
  deliveryProfile DeliveryProfile?
  auditLogs     AuditLog[]
  productionBatches ProductionBatch[]
  warehouseTransfers WarehouseTransfer[]
  wasteLogs     WasteLog[]
  pinCode       String?
  attendanceRecords AttendanceRecord[]
  inventoryAudits InventoryAudit[]
  requestedRequisitions InternalRequisition[] @relation("RequisitionRequester")
  approvedRequisitions  InternalRequisition[] @relation("RequisitionApprover")
  dispatchedRequisitions InternalRequisition[] @relation("RequisitionDispatcher")
  receivedRequisitions  InternalRequisition[] @relation("RequisitionReceiver")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Brand {
  id             String        @id @default(uuid())
  name           String        @unique
  slug           String        @unique
  logoUrl        String?
  primaryColor   String        @default("#E2E8F0")
  secondaryColor String        @default("#0F172A")
  isActive       Boolean       @default(true)
  users          UserBrand[]
  categories     Category[]
  products       Product[]
  ingredients    Ingredient[]
  orders         Order[]
  purchases      Purchase[]
  cashSessions   CashSession[]
  tables         Table[]
  customers      Customer[]
  coupons        Coupon[]
  combos         Combo[]
  auditLogs      AuditLog[]
  paymentSandboxMode Boolean     @default(true)
  allowOnlinePayments Boolean    @default(true)
  stripeSecretKey    String?
  stripePublicKey    String?
  stripeWebhookSecret String?
  mpAccessToken      String?
  mpPublicKey        String?
  mpWebhookSecret    String?
  paymentTransactions PaymentTransaction[]
  modifierGroups ModifierGroup[]
  warehouses     Warehouse[]
  productionBatches ProductionBatch[]
  warehouseTransfers WarehouseTransfer[]
  wasteLogs      WasteLog[]
  rfc            String?
  legalName      String?
  taxRegime      String?       @default("601")
  postalCode     String?
  invoiceSeries  String?       @default("FAC")
  invoiceNextFolio Int         @default(1)
  pacEnvironment String        @default("SANDBOX")
  invoices       Invoice[]
  printers       Printer[]
  attendanceRecords AttendanceRecord[]
  reservations   Reservation[]
  waitlistEntries WaitlistEntry[]
  priceRules     PriceRule[]
  giftCards      GiftCard[]
  inventoryAudits InventoryAudit[]
  internalRequisitions InternalRequisition[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model UserBrand {
  userId  String
  brandId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([userId, brandId])
}

model Table {
  id        String    @id @default(uuid())
  number    String
  name      String
  capacity  Int       @default(4)
  status    String    @default("AVAILABLE")
  zone      String    @default("Salón")
  brandId   String
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  orders    Order[]
  reservations Reservation[]
  waitlistEntries WaitlistEntry[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([number, brandId])
}

model Category {
  id        String    @id @default(uuid())
  name      String
  brandId   String
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([name, brandId])
}

model Product {
  id          String       @id @default(uuid())
  name        String
  description String?
  price       Float
  imageUrl    String?
  categoryId  String
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  brandId     String
  brand       Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  isActive    Boolean      @default(true)
  targetPrepTime Int?      @default(10)
  kitchenStation String?   @default("COCINA")
  recipeItems RecipeItem[]
  orderItems  OrderItem[]
  comboItems  ComboItem[]
  modifierGroups ProductModifierGroup[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Ingredient {
  id          String       @id @default(uuid())
  name        String
  stock       Float        @default(0)
  unit        String
  cost        Float        @default(0)
  minStock    Float        @default(0)
  type        String       @default("RAW")
  yieldQuantity Float?
  yieldUnit   String?
  brandId     String
  brand       Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  recipeItems RecipeItem[]
  purchases   Purchase[]
  modifierOptions ModifierOption[]
  parentSubRecipes SubRecipeItem[] @relation("ParentSubRecipe")
  childSubRecipes  SubRecipeItem[] @relation("ChildSubRecipe")
  productionBatches ProductionBatch[]
  warehouseStocks  WarehouseStock[]
  warehouseTransfers WarehouseTransfer[]
  wasteLogs        WasteLog[]
  auditItems       InventoryAuditItem[]
  requisitionItems RequisitionItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([name, brandId])
}

model RecipeItem {
  id           String     @id @default(uuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity     Float
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([productId, ingredientId])
}

model Order {
  id           String       @id @default(uuid())
  orderNumber  String       @unique
  brandId      String
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  source       String       @default("WEB")
  status       String       @default("RECEIVED")
  customerName String
  customerPhone String?
  customerAddress String?
  notes        String?
  subtotal     Float
  tax          Float
  tip          Float        @default(0)
  total        Float
  driverId     String?
  driver       User?        @relation("DeliveryDriver", fields: [driverId], references: [id])
  tableId      String?
  table        Table?       @relation(fields: [tableId], references: [id])
  diners       Int?         @default(1)
  customerId   String?
  customer     Customer?    @relation(fields: [customerId], references: [id])
  couponId     String?
  coupon       Coupon?      @relation(fields: [couponId], references: [id])
  couponCode   String?
  discountAmount Float      @default(0)
  externalOrderId String?
  platformCommissionRate Float? @default(0)
  platformCommission Float? @default(0)
  netPayout    Float?
  deliveryService String?
  paymentStatus String       @default("PENDING")
  paymentMethod String?
  paidAmount    Float        @default(0)
  changeAmount  Float        @default(0)
  paidAt        DateTime?
  paymentTransactionId String?
  paymentTransactions PaymentTransaction[]
  invoiceId    String?      @unique
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id])
  prepTimeTarget Int?       @default(15)
  cookingStartedAt DateTime?
  cookingFinishedAt DateTime?
  currentStage String?      @default("STARTER")
  items        OrderItem[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model OrderItem {
  id           String    @id @default(uuid())
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  quantity     Int
  price        Float
  notes        String?
  modifiers    String?
  status       String    @default("PENDING")
  serviceStage String?   @default("MAIN")
  startedAt    DateTime?
  finishedAt   DateTime?
}

model Purchase {
  id           String     @id @default(uuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity     Float
  cost         Float
  supplier     String?
  purchaseDate DateTime   @default(now())
  brandId      String
  brand        Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

model CashSession {
  id              String            @id @default(uuid())
  brandId         String
  brand           Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  openedAt        DateTime          @default(now())
  closedAt        DateTime?
  openingBalance  Float
  closingBalance  Float?
  expectedBalance Float?
  actualBalance   Float?
  status          String            @default("OPEN")
  cashSales       Float             @default(0)
  cardSales       Float             @default(0)
  appsSales       Float             @default(0)
  giftCardSales   Float             @default(0)
  transfersSales  Float             @default(0)
  cashInTotal     Float             @default(0)
  cashOutTotal    Float             @default(0)
  canceledTotal   Float             @default(0)
  discountsTotal  Float             @default(0)
  tipsTotal       Float             @default(0)
  tipsCash        Float             @default(0)
  tipsCard        Float             @default(0)
  consecutiveZ    Int?
  blindCount      String?
  notes           String?
  movements       CashMovement[]
  cuts            CashCut[]
}

model CashMovement {
  id            String      @id @default(uuid())
  cashSessionId String
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  type          String      // "IN" (Entrada/Cambio) o "OUT" (Retiro/Sangria)
  amount        Float
  reason        String
  category      String?     // "CHANGE_FLOAT", "SAFE_DROP", "EXPENSE", "SUPPLIER_PAYMENT", "OTHER"
  createdById   String?
  createdByName String?
  createdAt     DateTime    @default(now())
}

model CashCut {
  id                  String      @id @default(uuid())
  cashSessionId       String
  cashSession         CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  cutType             String      // "CORTE_X" o "CORTE_Z"
  cutNumber           String      // ej. "X-001" o "Z-0042"
  consecutive         Int
  openedAt            DateTime
  cutAt               DateTime    @default(now())
  openingBalance      Float
  cashSales           Float       @default(0)
  cardSales           Float       @default(0)
  appsSales           Float       @default(0)
  giftCardSales       Float       @default(0)
  transfersSales      Float       @default(0)
  totalSales          Float       @default(0)
  cashInTotal         Float       @default(0)
  cashOutTotal        Float       @default(0)
  expectedCash        Float
  expectedTotal       Float
  declaredCash        Float
  declaredCard        Float       @default(0)
  declaredOther       Float       @default(0)
  totalDeclared       Float
  cashDifference      Float       // declaredCash - expectedCash (positivo = sobrante, negativo = faltante)
  totalDifference     Float
  denominations       String?     // JSON con conteo de billetes y monedas
  ordersCount         Int         @default(0)
  discountsTotal      Float       @default(0)
  canceledOrdersCount Int         @default(0)
  canceledAmount      Float       @default(0)
  tipsTotal           Float       @default(0)
  tipsCash            Float       @default(0)
  tipsCard            Float       @default(0)
  printedAt           DateTime?
  notes               String?
  createdById         String?
  createdByName       String?
  createdAt           DateTime    @default(now())
}

model DeliveryProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType String
  plateNumber String?
  status      String   @default("AVAILABLE")
}

model Customer {
  id               String     @id @default(uuid())
  name             String
  phone            String     @unique
  email            String?
  address          String?
  notes            String?
  birthDate        String?
  tier             String     @default("BRONZE")
  pointsMultiplier Float      @default(1.0)
  tierDiscountPct  Float      @default(0.0)
  totalOrders      Int        @default(0)
  totalSpent       Float      @default(0.0)
  loyaltyPoints    Int        @default(0)
  brandId          String?
  brand            Brand?     @relation(fields: [brandId], references: [id])
  orders           Order[]
  giftCards        GiftCard[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  description    String?
  discountType   String
  discountValue  Float
  minOrderAmount Float     @default(0)
  maxDiscount    Float?
  usageLimit     Int?
  usedCount      Int       @default(0)
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean   @default(true)
  brandId        String?
  brand          Brand?    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  orders         Order[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Combo {
  id          String      @id @default(uuid())
  name        String
  description String?
  price       Float
  imageUrl    String?
  isActive    Boolean     @default(true)
  brandId     String
  brand       Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  items       ComboItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model ComboItem {
  id        String   @id @default(uuid())
  comboId   String
  combo     Combo    @relation(fields: [comboId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String?
  details    String?
  severity   String   @default("INFO")
  ipAddress  String?
  brandId    String?
  brand      Brand?   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([brandId, createdAt])
  @@index([action])
  @@index([entityType])
}

model PaymentTransaction {
  id               String   @id @default(uuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  brandId          String?
  brand            Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  gateway          String
  status           String   @default("PENDING")
  amount           Float
  tip              Float    @default(0)
  currency         String   @default("MXN")
  method           String?
  splitIndex       Int?
  notes            String?
  gatewayPaymentId String?
  gatewayOrderId   String?
  paymentUrl       String?
  rawResponse      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([orderId])
  @@index([brandId])
  @@index([gatewayPaymentId])
  @@index([status])
}

model ModifierGroup {
  id          String                 @id @default(uuid())
  name        String
  minSelect   Int                    @default(0)
  maxSelect   Int                    @default(1)
  isRequired  Boolean                @default(false)
  brandId     String
  brand       Brand                  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  options     ModifierOption[]
  products    ProductModifierGroup[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([name, brandId])
}

model ModifierOption {
  id                 String         @id @default(uuid())
  modifierGroupId    String
  modifierGroup      ModifierGroup  @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  name               String
  price              Float          @default(0)
  ingredientId       String?
  ingredient         Ingredient?    @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  ingredientQuantity Float?         @default(0)
  isDefault          Boolean        @default(false)
  order              Int            @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model ProductModifierGroup {
  id              String        @id @default(uuid())
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroupId String
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  order           Int           @default(0)

  @@unique([productId, modifierGroupId])
}

model Warehouse {
  id            String              @id @default(uuid())
  name          String
  code          String?
  description   String?
  isDefault     Boolean             @default(false)
  brandId       String
  brand         Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  stocks        WarehouseStock[]
  transfersFrom WarehouseTransfer[] @relation("TransferSource")
  transfersTo   WarehouseTransfer[] @relation("TransferDestination")
  wasteLogs     WasteLog[]
  inventoryAudits InventoryAudit[]
  requisitionsFrom InternalRequisition[] @relation("RequisitionSourceWarehouse")
  requisitionsTo   InternalRequisition[] @relation("RequisitionDestWarehouse")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([name, brandId])
}

model WarehouseStock {
  id           String     @id @default(uuid())
  warehouseId  String
  warehouse    Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  stock        Float      @default(0)
  minStock     Float      @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([warehouseId, ingredientId])
}

model SubRecipeItem {
  id                 String     @id @default(uuid())
  parentIngredientId String
  parentIngredient   Ingredient @relation("ParentSubRecipe", fields: [parentIngredientId], references: [id], onDelete: Cascade)
  childIngredientId  String
  childIngredient    Ingredient @relation("ChildSubRecipe", fields: [childIngredientId], references: [id], onDelete: Cascade)
  quantity           Float
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@unique([parentIngredientId, childIngredientId])
}

model ProductionBatch {
  id           String     @id @default(uuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity     Float
  totalCost    Float
  unitCost     Float
  notes        String?
  brandId      String
  brand        Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?      @relation(fields: [userId], references: [id])
  createdAt    DateTime   @default(now())
}

model WarehouseTransfer {
  id              String     @id @default(uuid())
  ingredientId    String
  ingredient      Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity        Float
  fromWarehouseId String
  fromWarehouse   Warehouse  @relation("TransferSource", fields: [fromWarehouseId], references: [id], onDelete: Cascade)
  toWarehouseId   String
  toWarehouse     Warehouse  @relation("TransferDestination", fields: [toWarehouseId], references: [id], onDelete: Cascade)
  notes           String?
  brandId         String
  brand           Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?      @relation(fields: [userId], references: [id])
  createdAt       DateTime   @default(now())
}

model WasteLog {
  id           String     @id @default(uuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity     Float
  costPerUnit  Float
  totalCost    Float
  reason       String
  notes        String?
  warehouseId  String?
  warehouse    Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  brandId      String
  brand        Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?      @relation(fields: [userId], references: [id])
  createdAt    DateTime   @default(now())
}

model Invoice {
  id                    String    @id @default(uuid())
  uuid                  String    @unique
  folio                 Int
  serie                 String    @default("FAC")
  brandId               String
  brand                 Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  orderId               String?   @unique
  order                 Order?
  rfcReceptor           String
  nombreReceptor        String
  regimenFiscalReceptor String
  codigoPostalReceptor  String
  usoCfdi               String
  emailReceptor         String?
  subtotal              Float
  descuento             Float     @default(0)
  iva                   Float
  total                 Float
  formaPago             String
  metodoPago            String    @default("PUE")
  fechaEmision          DateTime  @default(now())
  fechaTimbrado         DateTime  @default(now())
  selloDigital          String
  selloSat              String
  noCertificadoSat      String
  cadenaOriginalSat     String
  qrSatUrl              String
  xmlContent            String
  status                String    @default("TIMBRADO")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([brandId])
  @@index([uuid])
  @@index([rfcReceptor])
}

model Printer {
  id               String    @id @default(uuid())
  brandId          String
  brand            Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name             String
  connectionType   String    @default("NETWORK")
  ipAddress        String    @default("192.168.1.200")
  port             Int       @default(9100)
  paperWidth       String    @default("80mm")
  targetStation    String    @default("ALL")
  autoPrintTrigger String    @default("ON_ORDER_CREATED")
  isActive         Boolean   @default(true)
  status           String    @default("ONLINE")
  lastTestedAt     DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([brandId])
}

model AttendanceRecord {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId        String
  brand          Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  clockIn        DateTime  @default(now())
  clockOut       DateTime?
  breakMinutes   Int       @default(0)
  totalHours     Float?
  status         String    @default("ACTIVE")
  scheduledIn    DateTime?
  scheduledOut   DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([brandId])
  @@index([userId])
  @@index([status])
}

model Reservation {
  id              String    @id @default(uuid())
  brandId         String
  brand           Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  customerName    String
  customerPhone   String?
  customerEmail   String?
  diners          Int       @default(2)
  reservationDate DateTime
  durationMinutes Int       @default(90)
  status          String    @default("CONFIRMED")
  tableId         String?
  table           Table?    @relation(fields: [tableId], references: [id], onDelete: SetNull)
  zonePreference  String?   @default("ANY")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([brandId])
  @@index([reservationDate])
  @@index([status])
  @@index([tableId])
}

model WaitlistEntry {
  id                    String    @id @default(uuid())
  brandId               String
  brand                 Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  customerName          String
  customerPhone         String?
  diners                Int       @default(2)
  estimatedWaitMinutes  Int       @default(15)
  status                String    @default("WAITING")
  zonePreference        String?   @default("ANY")
  tableId               String?
  table                 Table?    @relation(fields: [tableId], references: [id], onDelete: SetNull)
  notifiedAt            DateTime?
  seatedAt              DateTime?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([brandId])
  @@index([status])
  @@index([createdAt])
  @@index([tableId])
}

model PriceRule {
  id              String    @id @default(uuid())
  brandId         String
  brand           Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  type            String    @default("PERCENTAGE_DISCOUNT") // PERCENTAGE_DISCOUNT, FIXED_PRICE, BUY_X_GET_Y
  discountValue   Float     @default(0) // e.g. 20 for 20% off, 120 for $120.00 fixed
  buyQty          Int?      @default(2) // for BUY_X_GET_Y: e.g. 2 in 2x1
  getQty          Int?      @default(1) // for BUY_X_GET_Y: e.g. 1 in 2x1 (pay for 1)
  daysOfWeek      String    @default("1,2,3,4,5") // Comma-separated: 0=Sun, 1=Mon, ..., 6=Sat
  startTime       String    @default("17:00") // HH:mm
  endTime         String    @default("20:00") // HH:mm
  isActive        Boolean   @default(true)
  appliesToAll    Boolean   @default(false)
  categoryIds     String?   // Comma-separated or JSON list of category IDs
  productIds      String?   // Comma-separated or JSON list of product IDs
  zone            String?   // Optional: "Salón", "Terraza", "Barra", or null for all
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([brandId])
  @@index([isActive])
}

model GiftCard {
  id             String                @id @default(uuid())
  code           String                @unique // e.g. "GC-8849-2024"
  pin            String?               // Optional security PIN (4 digits)
  brandId        String
  brand          Brand                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  initialBalance Float                 @default(0)
  balance        Float                 @default(0)
  status         String                @default("ACTIVE") // ACTIVE, DEPLETED, BLOCKED, EXPIRED
  expiresAt      DateTime?
  cardType       String                @default("DIGITAL") // DIGITAL, PHYSICAL, VIP_WALLET
  notes          String?
  transactions   GiftCardTransaction[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([brandId])
  @@index([code])
  @@index([status])
  @@index([customerId])
}

model GiftCardTransaction {
  id            String    @id @default(uuid())
  giftCardId    String
  giftCard      GiftCard  @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  type          String    // RECHARGE, DEBIT, REFUND, CASHBACK, ADJUSTMENT
  amount        Float     // Amount transacted
  balanceBefore Float
  balanceAfter  Float
  orderId       String?
  notes         String?
  createdById   String?
  createdAt     DateTime  @default(now())

  @@index([giftCardId])
  @@index([type])
  @@index([createdAt])
}

model InventoryAudit {
  id                    String               @id @default(uuid())
  brandId               String
  brand                 Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  auditNumber           String
  type                  String               @default("BLIND") // BLIND, FULL, PARTIAL
  status                String               @default("COMPLETED") // DRAFT, COMPLETED, APPLIED, CANCELLED
  warehouseId           String?
  warehouse             Warehouse?           @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  totalExpectedValue    Float                @default(0)
  totalCountedValue     Float                @default(0)
  totalDiscrepancyValue Float                @default(0)
  notes                 String?
  conductedById         String?
  conductedBy           User?                @relation(fields: [conductedById], references: [id])
  appliedAt             DateTime?
  items                 InventoryAuditItem[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([brandId])
  @@index([auditNumber])
}

model InventoryAuditItem {
  id              String         @id @default(uuid())
  auditId         String
  audit           InventoryAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  ingredientId    String
  ingredient      Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  expectedStock   Float
  countedStock    Float
  discrepancy     Float          // countedStock - expectedStock
  unitCost        Float
  discrepancyCost Float          // discrepancy * unitCost
  notes           String?
  createdAt       DateTime       @default(now())

  @@index([auditId])
  @@index([ingredientId])
}

model InternalRequisition {
  id                  String            @id @default(uuid())
  brandId             String
  brand               Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  folio               String            // REQ-0001
  type                String            @default("WAREHOUSE_TRANSFER") // WAREHOUSE_TRANSFER, PURCHASE_REQUEST
  urgency             String            @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  status              String            @default("SUBMITTED") // DRAFT, SUBMITTED, APPROVED, REJECTED, DISPATCHED, RECEIVED, CANCELLED
  fromWarehouseId     String?
  fromWarehouse       Warehouse?        @relation("RequisitionSourceWarehouse", fields: [fromWarehouseId], references: [id], onDelete: SetNull)
  toWarehouseId       String?
  toWarehouse         Warehouse?        @relation("RequisitionDestWarehouse", fields: [toWarehouseId], references: [id], onDelete: SetNull)
  requestedById       String?
  requestedBy         User?             @relation("RequisitionRequester", fields: [requestedById], references: [id])
  approvedById        String?
  approvedBy          User?             @relation("RequisitionApprover", fields: [approvedById], references: [id])
  approvedAt          DateTime?
  dispatchedById      String?
  dispatchedBy        User?             @relation("RequisitionDispatcher", fields: [dispatchedById], references: [id])
  dispatchedAt        DateTime?
  dispatchGuide       String?           // GUIA-0001
  receivedById        String?
  receivedBy          User?             @relation("RequisitionReceiver", fields: [receivedById], references: [id])
  receivedAt          DateTime?
  totalEstimatedCost  Float             @default(0)
  totalDiscrepancyCost Float            @default(0)
  notes               String?
  rejectionReason     String?
  items               RequisitionItem[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([brandId])
  @@index([folio])
  @@index([status])
}

model RequisitionItem {
  id             String              @id @default(uuid())
  requisitionId  String
  requisition    InternalRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  ingredientId   String
  ingredient     Ingredient          @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  requestedQty   Float
  approvedQty    Float               @default(0)
  dispatchedQty  Float               @default(0)
  receivedQty    Float               @default(0)
  discrepancyQty Float               @default(0)
  unitCost       Float               @default(0)
  notes          String?
  createdAt      DateTime            @default(now())

  @@index([requisitionId])
  @@index([ingredientId])
}

